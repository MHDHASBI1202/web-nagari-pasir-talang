rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /berita/{id} {
      allow read: if resource.data.status == 'published';
      allow write: if request.auth != null;
    }
    match /pengumuman/{id} {
      allow read: if resource.data.status == 'published';
      allow write: if request.auth != null;
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
